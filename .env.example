# ---------------------------------------------------------------------------
# OUTILIA — environment variables (placeholders only, never commit real values)
# Copy to .env.local for local development.
# All NEXT_PUBLIC_* variables are embedded in the client bundle: never put
# secrets in them.
# ---------------------------------------------------------------------------

# Canonical public origin used for canonical URLs, sitemap and Open Graph.
# No trailing slash. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Advertising (disabled by default) -------------------------------------
# Set to "true" only once your AdSense account is approved and consent is configured.
NEXT_PUBLIC_ADS_ENABLED=false
# Your AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad slot ids per placement (numeric slot ids from AdSense)
NEXT_PUBLIC_ADSENSE_SLOT_DIRECTORY=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_BOTTOM=

# --- Consent management (disabled by default) ------------------------------
# "builtin" uses the first-party consent banner shipped with the site.
# A certified Google CMP is REQUIRED before enabling AdSense for EEA traffic;
# set to "external" and load the CMP script from src/components/monetization/ConsentProvider.tsx.
NEXT_PUBLIC_CONSENT_MODE=builtin

# --- Analytics (disabled by default) ----------------------------------------
# "none" | "plausible" | "gtag"
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: the domain configured in your Plausible account
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible script host (default https://plausible.io)
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (requires consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Search Console / verification (optional) -------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Identité légale (mentions légales, confidentialité, contact). Laisser vide affiche
# un marqueur « à compléter » sur les pages concernées ; rien n'est inventé.
NEXT_PUBLIC_LEGAL_PUBLISHER_NAME=
NEXT_PUBLIC_LEGAL_PUBLISHER_STATUS=
NEXT_PUBLIC_LEGAL_PUBLISHER_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS=
