# ---------------------------------------------------------------------------
# AVEROPDF — environment variables (placeholders only, never commit real values)
# Copy to .env.local for local development.
# All NEXT_PUBLIC_* variables are embedded in the client bundle: never put
# secrets in them.
# ---------------------------------------------------------------------------

# Canonical public origin used for canonical URLs, sitemap and Open Graph.
# No trailing slash. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview deployments only: "true" forbids indexing everywhere (robots.txt, meta robots,
# X-Robots-Tag header, no sitemap advertised). Must be absent or "false" in production.
NEXT_PUBLIC_NOINDEX=false

# --- Advertising (disabled by default) -------------------------------------
# Nothing is loaded and no space is reserved unless ALL of the following hold:
# NEXT_PUBLIC_ADS_ENABLED=true, a provider, a publisher id, an ad unit id for
# the placement, and the visitor's consent. Details: docs/MONETISATION_PUBLICITAIRE.md
NEXT_PUBLIC_ADS_ENABLED=false
# "none" | "adsense"
NEXT_PUBLIC_ADS_PROVIDER=none
# Development only: show simulation boxes where ads could appear (ignored in production builds)
NEXT_PUBLIC_ADS_PREVIEW=false
# AdSense publisher id from your approved account (format ca-pub-<digits>); leave empty until then
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense ad unit ids, one per logical placement; an empty value keeps that placement off
NEXT_PUBLIC_ADSENSE_SLOT_HOME_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_AFTER_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_END=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_INLINE=

# --- Consent management (disabled by default) ------------------------------
# "builtin" uses the first-party consent banner shipped with the site.
# A certified Google CMP is REQUIRED before enabling AdSense for EEA traffic;
# set to "external" and load the CMP script from src/components/monetization/ConsentProvider.tsx.
NEXT_PUBLIC_CONSENT_MODE=builtin

# --- Analytics (disabled by default) ----------------------------------------
# "none" | "plausible" | "gtag"
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: the domain configured in your Plausible account
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible script host (default https://plausible.io)
NEXT_PUBLIC_PLAUSIBLE_HOST=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (requires consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Search Console / verification (optional) -------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Identité légale (mentions légales, confidentialité, contact). Laisser vide affiche
# un marqueur « à compléter » sur les pages concernées ; rien n'est inventé.
# Type d'éditeur (obligatoire en production, voir docs/LANCEMENT_SANS_PUBLICITE.md) :
#   individual = particulier identifié (nom et adresse publiés, aucune mention d'entreprise)
#   company    = entreprise ou micro-entreprise (immatriculation obligatoire)
#   anonymous  = particulier non professionnel ayant confié son identité à l'hébergeur
#                (LCEN art. 1-1, II) — à valider juridiquement avant de l'utiliser
NEXT_PUBLIC_LEGAL_PUBLISHER_KIND=
NEXT_PUBLIC_LEGAL_PUBLISHER_NAME=
# Entreprise : forme juridique. Particulier : facultatif (ex. « à titre non professionnel »).
NEXT_PUBLIC_LEGAL_PUBLISHER_STATUS=
NEXT_PUBLIC_LEGAL_PUBLISHER_ADDRESS=
# Entreprise uniquement.
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
# Particulier : facultatif (l'éditeur est alors le directeur de la publication).
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_HOSTING_PROVIDER=
NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS=
# Téléphone de l'hébergeur (LCEN art. 1-1, I, 4°), relevé sur ses pages officielles.
NEXT_PUBLIC_LEGAL_HOSTING_PHONE=
